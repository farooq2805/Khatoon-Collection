# Copy to .env.production on the server and fill in real values (never commit it).
# Copy the current values from Vercel: Project > Settings > Environment Variables.
NEXT_PUBLIC_API_URL=https://api.khatooncollection.in/api
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Same Postgres database as the store API (copied from the API's .env by deploy.sh).
# Used for checkout prospects (abandoned carts) in the "storefront" schema.
DATABASE_URL=
# Long random string; the admin dashboard must send it as "Authorization: Bearer <key>"
PROSPECTS_API_KEY=
# Instagram reels on the homepage: file holding the long-lived Instagram API token
INSTAGRAM_TOKEN_FILE=/home/khatooncollection/instagram-token.txt
